    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/codex-halo-hook\" --codex-halo",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\codex-halo-hook.exe\" --codex-halo",
            "timeout": 5,
            "statusMessage": "Updating Codex Halo"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/codex-halo-hook\" --codex-halo",
            "commandWindows": "& \"$env:PLUGIN_ROOT\\bin\\codex-halo-hook.exe\" --codex-halo",
