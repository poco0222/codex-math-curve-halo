          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run-helper.sh\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\hooks\\run-helper.ps1\"",
