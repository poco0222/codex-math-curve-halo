{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Halo",
  "version": "0.1.0",
  "identifier": "com.codex-halo.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true
  }
}
