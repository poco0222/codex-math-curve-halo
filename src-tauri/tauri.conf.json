{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Halo",
  "version": "0.1.0",
  "identifier": "com.codex-halo.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:sidecar",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.agents/plugins/marketplace.json": "codex-halo-marketplace/.agents/plugins/marketplace.json",
      "../plugins/codex-halo/.codex-plugin/plugin.json": "codex-halo-marketplace/plugins/codex-halo/.codex-plugin/plugin.json",
      "../plugins/codex-halo/README.md": "codex-halo-marketplace/plugins/codex-halo/README.md",
      "../plugins/codex-halo/assets/icon.png": "codex-halo-marketplace/plugins/codex-halo/assets/icon.png",
      "../plugins/codex-halo/hooks/hooks.json": "codex-halo-marketplace/plugins/codex-halo/hooks/hooks.json",
      "../plugins/codex-halo/hooks/run-helper.sh": "codex-halo-marketplace/plugins/codex-halo/hooks/run-helper.sh",
      "../plugins/codex-halo/hooks/run-helper.ps1": "codex-halo-marketplace/plugins/codex-halo/hooks/run-helper.ps1"
    },
    "externalBin": ["binaries/codex-halo-hook"]
  }
}
