{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Halo",
  "version": "0.1.0",
  "identifier": "com.codex-halo.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:sidecar",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/codex-halo-hook"]
  }
}
